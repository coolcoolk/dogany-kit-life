#!/usr/bin/env python3
"""retro-section -- the ledger block of the daily / weekly retro.

  retro-section --lane daily|weekly [--poll] [--mode line|section] [--today D] [--no-mark]
  retro-section nudge [--today D]     the separate-time sweep message (routine)

Direct calls print the owner-facing block, then a last line
`DIGEST<TAB><hex><TAB><lane>` for the caller (never shown): pass it to
`review apply --lane <lane> --expect <hex>`. Exit 3 = nothing to show (say
nothing about the ledger in that retro).
--poll runs the SMS collector first (fail-open), so tonight's card SMS are in.
Placement: after the retro's task/event stages, before its close.
"""
import argparse, datetime, os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ledgerlib import collector, kit, retro, seed

ap = argparse.ArgumentParser(prog='retro-section')
ap.add_argument('command', nargs='?', default='section', choices=('section', 'nudge'))
ap.add_argument('--lane', default='daily', choices=('daily', 'weekly'))
ap.add_argument('--poll', action='store_true')
ap.add_argument('--mode', choices=('line', 'section'))
ap.add_argument('--today')
ap.add_argument('--no-mark', action='store_true')
a = ap.parse_args()
today = datetime.date.fromisoformat(a.today) if a.today else datetime.date.today()
if a.command == 'nudge':
    print(retro.sweep_ask(today, tail=False)[0])
    sys.exit(0)
try:
    if a.poll and retro.poll_allowed() and seed.enabled_sms_sources():
        try:
            collector.poll(today=today)
        except kit.KitError:
            raise
        except Exception:
            pass  # fail-open: the retro goes on with what is already staged
    text, plan = retro.section(a.lane, today=today, mark=not a.no_mark)
except kit.KitError as e:
    print('{"error": "%s"}' % str(e).replace('"', "'"))
    sys.exit(2)
if not text:
    sys.exit(3)
print(text)
if a.mode is None:
    print('DIGEST\t%s\t%s' % (plan['digest'], plan['lane']))
