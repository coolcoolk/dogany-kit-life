#!/usr/bin/env python3
"""seed -- idempotently register this module's intake sources + money match
rule through the kit verbs. Never flips an existing source's enabled bit.
  seed            -> {"actions":[...]}   ([] on a repeat run)
"""
import json, os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ledgerlib import kit, seed
try:
    print(json.dumps({'actions': seed.ensure()}, ensure_ascii=False))
except kit.KitError as e:
    print(json.dumps({'error': str(e)}, ensure_ascii=False))
    sys.exit(2)
