#!/usr/bin/env python3
"""csv-import -- a Banksalad export through the kit's ledger-import verb (ledger v6):
the weekly sweep's file lane and any later file.

  csv-import <file> [--password-stdin]

<file>: the Banksalad CSV, the xlsx, or the zip Banksalad mails (the kit reads
them with the stdlib). An encrypted zip -> {"error":"password-needed..."}: ask
the owner once, re-run with the password as one stdin line (used for this
call only, never stored or logged). Other refusals: password-wrong,
xlsx-locked (an Excel file with its own password / legacy .xls),
zip-encryption-unsupported (AES).

The import merges with the rows already in the ledger (same payment seen
again is attached, not added: an overlapping export cannot double a month),
so there is no archive decision to wait for. Output: counts plus the
owner-facing summary line.
"""
import collections, json, os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ledgerlib import kit, seed, text, settlement

args = [x for x in sys.argv[1:] if x != '--password-stdin']
if len(args) != 1:
    sys.exit(__doc__)
try:
    password = sys.stdin.readline().rstrip('\r\n') or None if '--password-stdin' in sys.argv else None
    seed.ensure()
    res = kit.ledger_import(args[0], password=password)
    password = None
except (ValueError, kit.KitError) as e:
    print(json.dumps({'error': getattr(e, 'message', None) or str(e)}, ensure_ascii=False))
    sys.exit(2)
say = text.t('ledger.csvimport.say', events=res['events'], new=res['new'], attached=res['attached'])
if res['same']:
    say += text.t('ledger.csvimport.same', same=res['same'])
print(json.dumps({'count': res['events'], 'new': res['new'], 'attached': res['attached'], 'same': res['same'],
                  'first': res['first'], 'last': res['last'], 'say': say,
                  'settlement': [c for c in [settlement.render(s) for s in res.get('settlement',{}).get('splits',[])] + [settlement.render_match(m) for m in res.get('settlement',{}).get('transfers',[])] if c]}, ensure_ascii=False, sort_keys=True))
