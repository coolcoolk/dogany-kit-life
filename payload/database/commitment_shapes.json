    },
    "session_count": {
      "period": "week",
      "choices": [
        2,
        3,
        4
      ],
      "recommend": 2,
      "basis": "strength_days"
    },
    "sessions_per_week": {
      "period": "week",
      "choices": [
        2,
        3,
        4
      ],
      "recommend": 2,
      "basis": "strength_days"
    },
    "monthly_spend": {
      "period": "month"
    },
    "daily_steps": {
      "period": "day",
      "unit_copy": "habit.unit.steps"
    },
    "steps_per_day": {
      "period": "day",
      "unit_copy": "habit.unit.steps"
